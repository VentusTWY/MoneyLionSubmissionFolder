# Backend service secret. Generate a long, random value; never commit the real value.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Demo login credentials. Set your own values; never commit the real file.
ADMIN_DEMO_EMAIL=admin@example.com
ADMIN_DEMO_PASSWORD=replace-with-a-demo-password
ADMIN_SESSION_SECRET=replace-with-a-second-long-random-secret
